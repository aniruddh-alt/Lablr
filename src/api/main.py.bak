from typing import List, Optional, D@app.get("/extraction/jobs/{job_id}", response_model=ExtractionJobResponse)
async def get_extraction_job(job_id: str, db: Session = Depends(get_db)):
    """
    Get extraction job status and results.
    
    Args:
        job_id: Extraction job ID
    
    Returns:
        Job status and results
    """
    try:
        # First try to get from database
        job = db.query(DBExtractionJob).filter(DBExtractionJob.id == job_id).first()
        
        if not job:
            raise HTTPException(status_code=404, detail="Extraction job not found")
            
        # If job is not in a final state, check Celery task status
        if job.status not in ["completed", "failed"]:
            from ..workers.celery_app import celery_app
            try:
                task_id = job.progress.get("task_id") if job.progress else None
                if task_id:
                    result = celery_app.AsyncResult(task_id)
                    status = result.status.lower()
                    
                    # Update job status in database if changed
                    if status != job.status and status in ["success", "failure"]:
                        job.status = "completed" if status == "success" else "failed"
                        if result.ready():
                            job.result = result.result
                        if status in ["success", "failure"]:
                            job.completed_at = datetime.now(timezone.utc)
                        db.commit()
            except Exception as e:
                logger.warning(f"Error checking Celery task status: {str(e)}")
                
        return ExtractionJobResponse.from_orm(job)
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error retrieving extraction job {job_id}: {str(e)}")
        raise HTTPException(
            status_code=500,
            detail=f"Failed to retrieve extraction job: {str(e)}"
