# Lablr Configuration Template
# Copy this file to .env and fill in your actual values

# ==================== AZURE SERVICES ====================
# Azure Form Recognizer
AZURE_FORM_RECOGNIZER_ENDPOINT=https://your-form-recognizer.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_KEY=your_form_recognizer_key_here

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_KEY=your_openai_key_here
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Alternative: Azure Cognitive Services (legacy support)
# AZURE_COGNITIVE_SERVICES_ENDPOINT=https://your-cognitive.cognitiveservices.azure.com/
# AZURE_COGNITIVE_SERVICES_KEY=your_cognitive_key

# ==================== DATABASE & CACHE ====================
# Redis (required for Celery)
REDIS_URL=redis://localhost:6379

# Database (optional - defaults to in-memory for development)
# DATABASE_URL=postgresql://username:password@localhost:5432/lablr

# ==================== APPLICATION SETTINGS ====================
# Security
SECRET_KEY=your-super-secret-key-change-in-production

# File handling
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# Processing
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT=3600  # 1 hour in seconds
BATCH_SIZE=5

# Application
DEBUG=false
APP_NAME=Lablr

# ==================== OPTIONAL SERVICES ====================
# Azure Storage (for production file storage)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Service Bus (for advanced message queuing)
# SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://...

# Azure ML (for advanced ML workflows)
# AZURE_ML_WORKSPACE_NAME=your-ml-workspace
# AZURE_ML_RESOURCE_GROUP=your-resource-group
# AZURE_ML_SUBSCRIPTION_ID=your-subscription-id

# ==================== DEVELOPMENT SETTINGS ====================
# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# CORS (development only - restrict in production)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"] 